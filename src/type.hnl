--- type -- runtime type introspection interface for the handl platform.
---
--- This .hnl declares the capability surface for the `type` library. The
--- runtime `type` module is implemented in
--- `type-handl/type-handl.hnl` (moved to the `kit-canonical` repo in ADR-0128 Phase 11) (pure-handl predicates and
--- kind guards) over a small set of native `op` atoms, and is registered
--- under `"type"` by `kit-canonical`. `type` is a keyword in handl v0.1
--- (ADR-0074) but parses as a `var` atom, so `type.of(v)` in source
--- evaluates as `field-access(var("type"), "of")` -> host call `"type.of"`.
---
--- ## Runtime type introspection (type module)
---
--- type.of -- NATIVE op: return the kind tag of a value ("null", "bool",
--- "number", "string", "array", "object", "arrow", "bytes", "resource" --
--- the tree-walk engine's `type_tag` vocabulary).
--- type.tag / type.name / type.type_of / type.typeof -- pure-handl aliases
--- of `type.of`.
--- type.is_null / is_bool / is_number / is_string / is_array / is_object /
--- is_arrow / is_function / is_bytes / is_resource -- pure-handl predicates
--- over `type.of`.
--- type.is -- test whether a value matches a kind spelling (canonical tags,
--- short aliases "num"/"str"/"arr"/"obj", and `type.`-prefixed forms).
--- type.must -- assert a kind ({ok: v} or {err: msg}).
--- type.may -- project a kind (value or null).
--- type.not -- kind complement (value or null).
--- type.when -- kind guard with a default.
--- type.to_bool -- pure-handl truthiness.
--- type.to_string / type.to_number -- NATIVE ops: value coercion has no
--- eval-vocabulary primitive.
--- type.coalesce -- NATIVE op: variadic; handl arrows have fixed arity.
--- type.identity / type.default -- pure-handl.
---
--- Field-key kinds (`field.x`, variant-tag complements) are NOT part of
--- the `type` module -- there is no object-key enumeration primitive. The
--- legacy `typeof` module (`plugin-lib-utils`' `TypeModule`) still provides
--- them plus the old short-tag vocabulary ("num"/"str"/"arr"/"obj").
---
--- ## Typecheck engine (Rust)
---
--- The compile-time typecheck engine (NbE-based type synthesis) lives in
--- `hnl-engine-typecheck-nbe`, behind the
--- `hnl-engine-typecheck` abstraction (`check_module`); it is
--- not declared as `op`/`handl` here because it operates at the
--- inference layer, not the eval-time dispatch layer.
cap "type.of"
cap "type.type_of"
cap "type.typeof"
cap "type.to_string"
cap "type.to_number"
cap "type.to_bool"
cap "type.identity"
cap "type.default"
cap "type.coalesce"
cap "type.is"
cap "type.must"
cap "type.may"
cap "type.is_nominal"
cap "type.instanceof"
cap "type.ty"
cap "type.Int"
cap "type.Str"
cap "type.Bool"
cap "type.Null"
cap "type.Float"
cap "type.Number"
cap "type.Nat"
cap "type.Obj"
cap "type.Array"
cap "type.Value"
cap "type.Type"
cap "type.Grade"
cap "type.Unit"
op "type.is_nominal" : Value -> Bool
  guarantee: True
op "type.instanceof" : (Value, Value) -> Bool
  guarantee: True
op "type.ty" : Value -> Value
  guarantee: True
op "type.of" : Value -> String
  guarantee: IsString(output)
op "type.type_of" : Value -> String
  guarantee: IsString(output)
op "type.typeof" : Value -> String
  guarantee: IsString(output)
op "type.to_string" : Value -> String
  guarantee: IsString(output)
op "type.to_number" : Value -> Number
  guarantee: True
op "type.to_bool" : Value -> Bool
  guarantee: True
op "type.identity" : Value -> Value
  guarantee: True
op "type.default" : (Value, Value) -> Value
  guarantee: True
op "type.coalesce" : Value -> Value
  guarantee: True
op "type.is" : (Value, String) -> Bool
  guarantee: True
op "type.must" : (Value, String) -> Value
  guarantee: True
op "type.may" : (Value, String) -> Bool
  guarantee: True
op "type.not" : (Value, String) -> Bool
  guarantee: True
op "type.Unit" : Value -> Value
  guarantee: True
--- ## Type values (type-as-values) -- seeded nominals (ADR-0154 sec.1/2)
---
--- Declared types are seeded nominals `{"__sym__": {handle, name,
--- parent, type}}` minted by the host `type.<Name>` ops: deterministic
--- content-hash identity (ADR-0154 sec.1), `parent` = <: edges
--- (`Nat <: Int <: Number <: Value`), `type` = the membership link
--- (`Int.ty = Type`). `instanceof` reads `type`-link head then
--- `parent` walk; the legacy `__tag__` values are superseded (the
--- bridge keeps them readable until deletion).
export Int :: type.Int()
export Str :: type.Str()
export Bool :: type.Bool()
export Null :: type.Null()
export Float :: type.Float()
export Number :: type.Number()
export Nat :: type.Nat()
export Obj :: type.Obj()
export Array :: type.Array()
export Value :: type.Value()
export Type :: type.Type()
export Unit :: type.Unit()
